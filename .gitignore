# Generated by the build
build/
*.vcd
*.fs

# The OSS CAD Suite: 1.8 GB, and a symlink to ../tang/.tools at that
.tools

# ESP-IDF build output and fetched dependencies for the colour bar generator
tools/m5-colorbars/build/
tools/m5-colorbars/managed_components/
tools/m5-colorbars/sdkconfig.old

__pycache__/
*.pyc
.DS_Store

# KiCad: backups, local history, per-user view state, locks, autorouter files,
# and the intermediate gerber folders the JLCPCB plugin leaves behind
hardware/*-backups/
hardware/.history/
hardware/*.kicad_prl
hardware/*.lck
hardware/~*
hardware/fp-info-cache
hardware/*.dsn
hardware/*.ses
hardware/*.rules
hardware/*.frb
hardware/production/
hardware/jlcpcb/gerber/
hardware/jlcpcb/gerber.zip
